# Template for /home/deploy/app/.env on the VPS.
#
# This file is the only place production secrets live. It is never committed,
# never baked into an image, and never passed through GitHub Actions.
#
#   cp .env.example .env && chmod 600 .env
#
# Then fill in every REPLACE_ME below.

APP_NAME="Ocean Consumer Products"
APP_ENV=production
APP_DEBUG=false

# Generate ONCE, locally, with `php artisan key:generate --show`, and never
# change it again: it decrypts existing sessions, cookies and any encrypted
# column. Rotating it logs everyone out and makes encrypted data unreadable.
APP_KEY=REPLACE_ME

# Must be the real public domain, https. Laravel builds absolute URLs from
# this — password reset links, the storage disk's public URLs, and the redirect
# after login all read it.
APP_URL=https://app.galaxyconsumer.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# `postgres` and `redis` are the compose service names, resolved on the private
# docker network. Neither is published to the host, so neither is reachable
# from the internet.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=REPLACE_ME

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME

# Horizon only supports the redis queue driver — switching these to database or
# sync silently takes it out of the picture.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# Logos and product photos go to storage/app/public, which is a docker volume.
FILESYSTEM_DISK=local

# Who may open /horizon. Empty means nobody, which is the safe default.
HORIZON_ALLOWED_EMAILS=rtmsahik114@gmail.com

# Per-company invoice numbering. Set the starting number to continue a series
# a company already had on paper.
INVOICE_NUMBER_PREFIX=INV
INVOICE_STARTING_NUMBER=1
COMPANY_CURRENCY_SYMBOL=৳

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@galaxyconsumer.com"
MAIL_FROM_NAME="${APP_NAME}"

# Which image tag `docker compose up -d` runs. The deploy workflow overrides it
# with the commit SHA; set it by hand to roll back.
APP_IMAGE_TAG=latest
